{
  "name": "cellphones-qa-automation",
  "version": "1.0.0",
  "description": "Automation test suite for CellphoneS using Selenium WebDriver, Mocha and Chai.",
  "type": "module",
  "scripts": {
    "test": "set HEADLESS=false&& mocha \"test/auth/**/*.spec.js\" \"test/search/**/*.spec.js\" \"test/product-detail/**/*.spec.js\" \"test/filter/**/*.spec.js\" \"test/cart/**/*.spec.js\" --timeout 180000",
    "test:headed": "npm test",
    "test:headless": "set HEADLESS=true&& mocha \"test/auth/**/*.spec.js\" \"test/search/**/*.spec.js\" \"test/product-detail/**/*.spec.js\" \"test/filter/**/*.spec.js\" \"test/cart/**/*.spec.js\" --timeout 180000",
    "test:report": "set HEADLESS=false&& set MOCHAWESOME_REPORT_DIR=mochawesome-report&& mocha \"test/auth/**/*.spec.js\" \"test/search/**/*.spec.js\" \"test/product-detail/**/*.spec.js\" \"test/filter/**/*.spec.js\" \"test/cart/**/*.spec.js\" --timeout 180000 --reporter mochawesome --reporter-options reportDir=mochawesome-report,reportFilename=cellphones-report,overwrite=true,html=true,json=true",
    "test:auth": "set HEADLESS=false&& mocha \"test/auth/**/*.spec.js\" --timeout 180000",
    "test:search": "set HEADLESS=false&& mocha \"test/search/**/*.spec.js\" --timeout 180000",
    "test:cart": "set HEADLESS=false&& mocha \"test/cart/**/*.spec.js\" --timeout 180000"
  },
  "keywords": [
    "selenium",
    "mocha",
    "chai",
    "automation-testing",
    "cellphones"
  ],
  "author": "Software Testing Coursework",
  "license": "MIT",
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "mochawesome": "^7.1.4",
    "selenium-webdriver": "^4.43.0"
  }
}
